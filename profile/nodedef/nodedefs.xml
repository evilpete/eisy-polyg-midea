<nodeDefs>

  <!-- ============================================================= -->
  <!-- Controller                                                     -->
  <!-- ============================================================= -->
  <nodeDef id="MIDEACTRL" nls="MIDEACTRL">
    <editors />
    <sts>
      <st id="ST" editor="M_CTLST" />
      <st id="GV0" editor="M_COUNT" />
      <st id="GV1" editor="M_COUNT" />
    </sts>
    <cmds>
      <sends />
      <accepts>
        <cmd id="DISCOVER" />
        <cmd id="QUERY" />
        <cmd id="UPDATE_PROFILE" />
        <cmd id="REMOVE_NOTICES" />
      </accepts>
    </cmds>
  </nodeDef>

  <!-- ============================================================= -->
  <!-- Air conditioner (device type 0xAC)                             -->
  <!-- ============================================================= -->
  <nodeDef id="MIDEAAC" nls="MIDEAAC">
    <editors />
    <sts>
      <st id="ST" editor="M_BOOL" />           <!-- power -->
      <st id="GV0" editor="M_CONN" />          <!-- connection state -->
      <st id="CLITEMP" editor="M_TEMP" />      <!-- indoor temperature -->
      <st id="GV1" editor="M_TEMP" />          <!-- outdoor temperature -->
      <st id="CLISPC" editor="M_SETPOINT" />   <!-- target temperature -->
      <st id="CLIMD" editor="M_MODE" />        <!-- operational mode -->
      <st id="CLIFS" editor="M_FAN" />         <!-- fan speed preset -->
      <st id="GV2" editor="M_PCT" />        <!-- custom fan speed % -->
      <st id="CLIHUM" editor="M_HUM" />        <!-- indoor humidity -->
      <st id="GV3" editor="M_HUM" />          <!-- target humidity -->
      <st id="GV4" editor="M_SWING" />         <!-- swing mode -->
      <st id="GV5" editor="M_ANGLE" />         <!-- vertical louver angle -->
      <st id="GV6" editor="M_ANGLE" />         <!-- horizontal louver angle -->
      <st id="GV7" editor="M_BOOL" />          <!-- eco -->
      <st id="GV8" editor="M_BOOL" />          <!-- turbo -->
      <st id="GV9" editor="M_BOOL" />          <!-- sleep -->
      <st id="GV10" editor="M_BOOL" />         <!-- freeze protection -->
      <st id="GV11" editor="M_BOOL" />         <!-- display / LED -->
      <st id="GV12" editor="M_BOOL" />         <!-- purifier / ionizer -->
      <st id="GV13" editor="M_BOOL" />         <!-- follow me -->
      <st id="GV14" editor="M_BOOL" />         <!-- filter alert -->
      <st id="GV15" editor="M_BOOL" />         <!-- self clean active -->
      <st id="GV16" editor="M_ERR" />          <!-- error code -->
      <st id="GV17" editor="M_BREEZE" />       <!-- breeze mode -->
      <st id="GV18" editor="M_FRESH" />        <!-- fresh air fan speed -->
      <st id="GV19" editor="M_RATE" />         <!-- rate select / gear -->
      <st id="GV20" editor="M_AUX" />          <!-- aux heat mode -->
      <st id="GV21" editor="M_KWH" />          <!-- total energy -->
      <st id="GV22" editor="M_WATT" />         <!-- real time power -->
      <st id="GV23" editor="M_BOOL" />         <!-- beep on command -->
      <st id="GV24" editor="M_BOOL" />         <!-- defrost active -->
      <st id="GV25" editor="M_HZ" />           <!-- compressor frequency -->
      <st id="GV26" editor="M_TEMP" />         <!-- indoor coil temp (T2) -->
      <st id="GV27" editor="M_TEMP" />         <!-- outdoor coil temp (T3) -->
    </sts>
    <cmds>
      <sends />
      <accepts>
        <cmd id="DON" />
        <cmd id="DOF" />
        <cmd id="QUERY" />
        <cmd id="SELFCLEAN" />
        <cmd id="SETTEMP">
          <p id="TEMP" editor="M_SETPOINT_CMD" />
        </cmd>
        <cmd id="SETMODE">
          <p id="MODE" editor="M_MODE" />
        </cmd>
        <cmd id="SETFAN">
          <p id="FAN" editor="M_FAN" />
        </cmd>
        <cmd id="SETFANPCT">
          <p id="FANPCT" editor="M_FANPCT" />
        </cmd>
        <cmd id="SETTHUM">
          <p id="THUM" editor="M_THUM" />
        </cmd>
        <cmd id="SETSWING">
          <p id="SWING" editor="M_SWING" />
        </cmd>
        <cmd id="SETVANGLE">
          <p id="VANGLE" editor="M_ANGLE" />
        </cmd>
        <cmd id="SETHANGLE">
          <p id="HANGLE" editor="M_ANGLE" />
        </cmd>
        <cmd id="SETECO">
          <p id="ECO" editor="M_BOOL" />
        </cmd>
        <cmd id="SETTURBO">
          <p id="TURBO" editor="M_BOOL" />
        </cmd>
        <cmd id="SETSLEEP">
          <p id="SLEEP" editor="M_BOOL" />
        </cmd>
        <cmd id="SETFREEZE">
          <p id="FREEZE" editor="M_BOOL" />
        </cmd>
        <cmd id="SETDISPLAY">
          <p id="DISPLAY" editor="M_BOOL" />
        </cmd>
        <cmd id="SETPURIFY">
          <p id="PURIFY" editor="M_BOOL" />
        </cmd>
        <cmd id="SETFOLLOW">
          <p id="FOLLOW" editor="M_BOOL" />
        </cmd>
        <cmd id="SETBREEZE">
          <p id="BREEZE" editor="M_BREEZE" />
        </cmd>
        <cmd id="SETFRESH">
          <p id="FRESH" editor="M_FRESH" />
        </cmd>
        <cmd id="SETRATE">
          <p id="RATE" editor="M_RATE" />
        </cmd>
        <cmd id="SETAUX">
          <p id="AUX" editor="M_AUX" />
        </cmd>
        <cmd id="SETBEEP">
          <p id="BEEP" editor="M_BOOL" />
        </cmd>
      </accepts>
    </cmds>
  </nodeDef>

</nodeDefs>
